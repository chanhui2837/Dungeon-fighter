PORT=3000
NODE_ENV=development
# 로컬 MongoDB
MONGODB_URI=mongodb://localhost:27017/dungeon_fighter
# Atlas 예시 (Render 배포 시 이 형식 사용, 반드시 ?retryWrites=true&w=majority 포함)
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dungeon_fighter?retryWrites=true&w=majority
# Atlas 설정 체크리스트:
# 1. Database Access -> 유저 생성
# 2. Network Access -> IP Whitelist에 0.0.0.0/0 추가 (Render는 동적 IP)
# 3. Connection String 복사 시 <password>를 실제 비밀번호로 교체
JWT_SECRET=change_this_to_a_very_long_random_secret_32chars!
JWT_EXPIRES_IN=7d
# Render 통합 배포 시 비워둬도 됨 (동일 오리진 허용). 분리 배포 시 클라이언트 URL 명시
CLIENT_URL=http://localhost:5173
# 예: CLIENT_URL=https://your-client.onrender.com
BACKUP_INTERVAL_MS=3600000
